---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

import PreferencesScript from './PreferencesScript.astro';
import { LOCALES, otherLang, type Lang } from '../../i18n/config';
import { withLang } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import heroIllustration from '../../assets/hero-illustration.jpg';
import '../../styles/global.css';

export interface SeoProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
}

interface Props extends SeoProps {
  lang: Lang;
  alternateUrl?: string;
  redirectByBrowserLang?: boolean;
}

const {
  lang,
  title,
  description,
  image = heroIllustration,
  type = 'website',
  publishedTime,
  noindex = false,
  alternateUrl,
  redirectByBrowserLang,
} = Astro.props;

const t = useTranslations(lang);
const fullTitle = title ? `${title} · ${t.meta.siteName}` : t.home.title;
const metaDescription = description ?? t.meta.description;
/** Absolute URL with a trailing slash, matching the sitemap. */
const absolute = (path: string) => new URL(path.endsWith('/') ? path : `${path}/`, Astro.site);
const canonical = absolute(Astro.url.pathname);
const alternate = alternateUrl ? absolute(alternateUrl) : undefined;
const ogImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<PreferencesScript redirectByBrowserLang={redirectByBrowserLang} />

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<link rel="alternate" hreflang={lang} href={canonical} />
{alternate && <link rel="alternate" hreflang={otherLang(lang)} href={alternate} />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={t.blog.rss}
  href={new URL(withLang(lang, 'rss.xml'), Astro.site)}
/>
<link rel="sitemap" href="/sitemap-index.xml" />

<meta name="theme-color" content="#f9fafc" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#151618" media="(prefers-color-scheme: dark)" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={t.meta.siteName} />
<meta property="og:locale" content={LOCALES[lang].replace('-', '_')} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
