---
import Icon from '../ui/Icon.astro';
import { NAV_ITEMS } from './navigation';
import { SITE } from '../../data/site';
import { LANGS, type Lang } from '../../i18n/config';
import { routePath, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
  active?: RouteKey;
  alternateUrl: string;
}

const { lang, active, alternateUrl } = Astro.props;
const t = useTranslations(lang);
---

<header class="mobile-header">
  <div class="mobile-header__bar">
    <a href={routePath('home', lang)} class="mobile-header__name">
      {SITE.author}
    </a>

    <div class="lang-switch" role="group" aria-label={t.sidebar.language}>
      {LANGS.map((code) =>
        code === lang ? (
          <span class="lang-switch__option" aria-current="true">
            {code.toUpperCase()}
          </span>
        ) : (
          <a
            href={alternateUrl}
            class="lang-switch__option"
            hreflang={code}
            data-lang-switch={code}
            aria-label={t.sidebar.switchLang}
          >
            {code.toUpperCase()}
          </a>
        ),
      )}
    </div>

    <button
      type="button"
      class="theme-btn"
      data-theme-toggle
      aria-label={t.sidebar.themeToggle}
      title={t.sidebar.themeToggle}
    >
      <Icon name="moon" size={17} class="only-light" />
      <Icon name="sun" size={17} class="only-dark" />
    </button>
  </div>

  <nav class="mobile-header__nav" aria-label={t.nav.label}>
    {NAV_ITEMS.map(({ key, icon }) => (
      <a
        href={routePath(key, lang)}
        class="pill"
        aria-current={active === key ? 'page' : undefined}
      >
        <Icon name={icon} size={16} />
        {t.nav[key]}
      </a>
    ))}
  </nav>
</header>

<script>
  import '../../scripts/theme';
  import '../../scripts/language';
</script>

<style>
  .mobile-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px clamp(16px, 4vw, 32px);
    background: color-mix(in oklch, var(--bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 960px) {
    .mobile-header {
      display: none;
    }
  }

  .mobile-header__bar {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mobile-header__name {
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    color: var(--text);
    text-decoration: none;
  }

  .lang-switch {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 13px;
    font-weight: 500;
  }

  .lang-switch__option {
    padding: 4px 11px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
  }

  .lang-switch__option:hover {
    color: var(--text);
  }

  .lang-switch__option[aria-current='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  .theme-btn {
    all: unset;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface-2);
  }

  .theme-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mobile-header__nav {
    display: flex;
    gap: 4px;
    margin: 0 -4px;
    padding: 0 4px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 13px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    color: var(--muted);
  }

  .pill:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .pill[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
</style>
