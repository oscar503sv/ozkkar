---
import type { ClientWork } from '../../data/clients';
import type { Lang } from '../../i18n/config';

interface Props {
  client: ClientWork;
  lang: Lang;
}

const { client, lang } = Astro.props;
---

<article class="client">
  <h3 class="client__name">{client.name[lang]}</h3>
  <p class="client__desc">{client.description[lang]}</p>
  <p class="client__stack">{client.stack.join(' · ')}</p>
</article>

<style>
  .client {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 22px;
    background: var(--surface-2);
  }

  .client__name {
    font-size: 20px;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .client__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .client__stack {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-ink);
  }
</style>
