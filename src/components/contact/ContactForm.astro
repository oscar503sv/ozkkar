---
/**
 * Contact form. Topic and project type are native radio inputs styled as
 * rows/chips; conditional fields are toggled with CSS `:has()`. JS only
 * handles the placeholder and the async submit states.
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { SITE } from '../../data/site';
import type { Lang } from '../../i18n/config';
import { format, useTranslations } from '../../i18n/utils';
import { CONTACT_TOPICS } from '../../lib/contact';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).contact;
const topics = CONTACT_TOPICS.map((value, i) => ({ value, ...t.topics[i]! }));
const placeholders = Object.fromEntries(CONTACT_TOPICS.map((v, i) => [v, t.placeholders[i]]));
---

<div class="contact-card" data-contact>
  <form class="form" method="post" action="/api/contact" data-contact-form novalidate>
    <input type="hidden" name="lang" value={lang} />

    <fieldset class="fieldset">
      <legend class="legend">{t.about}</legend>
      <div class="topics">
        {topics.map(({ value, icon, label, sub }, i) => (
          <label class="topic">
            <input
              type="radio"
              name="topic"
              value={value}
              class="sr-only"
              checked={i === 0}
              data-placeholder={placeholders[value]}
            />
            <span class="topic__icon">
              <Icon name={icon} size={20} />
            </span>
            <span class="topic__text">
              <span class="topic__label">{label}</span>
              <span class="topic__sub">{sub}</span>
            </span>
            <Icon name="circle" size={20} class="topic__check topic__check--off" />
            <Icon name="check-circle-fill" size={20} class="topic__check topic__check--on" />
          </label>
        ))}
      </div>
    </fieldset>

    <div class="row">
      <label class="field">
        {t.name}
        <input class="input" name="name" required autocomplete="name" maxlength="120" />
      </label>
      <label class="field">
        {t.email}
        <input
          class="input"
          type="email"
          name="email"
          required
          autocomplete="email"
          maxlength="200"
        />
      </label>
    </div>

    <fieldset class="fieldset when-freelance">
      <legend class="field-label">{t.projectType}</legend>
      <div class="ptypes">
        {t.projectTypes.map((label, i) => (
          <label class="ptype">
            <input
              type="radio"
              name="projectType"
              value={label}
              class="sr-only"
              checked={i === 0}
            />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <div class="row when-job">
      <label class="field">
        {t.company}
        <input class="input" name="company" autocomplete="organization" maxlength="120" />
      </label>
      <label class="field">
        {t.role}
        <input class="input" name="role" autocomplete="organization-title" maxlength="120" />
      </label>
    </div>

    <label class="field">
      {t.message}
      <textarea
        class="input input--area"
        name="message"
        required
        maxlength="5000"
        placeholder={t.placeholders[0]}
        data-contact-message
      ></textarea>
    </label>

    <div class="honeypot" aria-hidden="true">
      <label>
        Website
        <input name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="footer">
      <span class="privacy">
        <Icon name="shield-check" />
        {t.privacy}
      </span>
      <Button type="submit" data-contact-submit>
        <span class="state" data-state="idle">
          <Icon name="paper-plane-tilt" />
          {t.send}
        </span>
        <span class="state" data-state="sending" hidden>
          <Icon name="spinner-gap" class="spin" />
          {t.sending}
        </span>
      </Button>
    </div>
    <p class="error" role="alert" data-contact-error hidden>
      {format(t.error, { email: SITE.email })}
    </p>
  </form>

  <div class="success" data-contact-success hidden tabindex="-1">
    <span class="success__icon">
      <Icon name="check" size={28} />
    </span>
    <h2 class="success__title">{t.sentTitle}</h2>
    <p class="success__body">{t.sentBody}</p>
    <Button variant="ghost" size="sm" icon="arrow-counter-clockwise" data-contact-reset>
      {t.another}
    </Button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-contact]');
  const form = root?.querySelector<HTMLFormElement>('[data-contact-form]');

  if (root && form) {
    const message = form.querySelector<HTMLTextAreaElement>('[data-contact-message]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]')!;
    const error = form.querySelector<HTMLElement>('[data-contact-error]')!;
    const success = root.querySelector<HTMLElement>('[data-contact-success]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-contact-reset]')!;
    const idleLabel = submit.querySelector<HTMLElement>('[data-state="idle"]')!;
    const sendingLabel = submit.querySelector<HTMLElement>('[data-state="sending"]')!;

    const syncPlaceholder = () => {
      const checked = form.querySelector<HTMLInputElement>('input[name="topic"]:checked');
      if (checked?.dataset.placeholder) message.placeholder = checked.dataset.placeholder;
    };

    const setSending = (sending: boolean) => {
      submit.disabled = sending;
      idleLabel.hidden = sending;
      sendingLabel.hidden = !sending;
    };

    form.addEventListener('change', (event) => {
      if ((event.target as HTMLInputElement).name === 'topic') syncPlaceholder();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      if (!form.reportValidity()) return;

      error.hidden = true;
      setSending(true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch {
        error.hidden = false;
      } finally {
        setSending(false);
      }
    });

    reset.addEventListener('click', () => {
      form.reset();
      syncPlaceholder();
      success.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name="topic"]')?.focus();
    });
  }
</script>

<style>
  .contact-card {
    flex: 1.5 1 440px;
    min-width: 0;
    padding: clamp(22px, 3vw, 32px);
    border-radius: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .legend {
    padding: 0;
    margin-bottom: 10px;
    font-size: 15px;
    font-weight: 600;
  }

  .field-label {
    padding: 0;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  /* ----- Topic rows ----- */

  .topics {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .topic {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--border);
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .topic:hover {
    border-color: var(--accent);
  }

  .topic:has(:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .topic:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .topic__icon {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: grid;
    place-items: center;
    background: var(--surface);
    color: var(--accent-ink);
  }

  .topic__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .topic__label {
    font-size: 15px;
    font-weight: 600;
  }

  .topic__sub {
    font-size: 13px;
    color: var(--muted);
  }

  .topic :global(.topic__check) {
    color: var(--accent-ink);
  }

  .topic :global(.topic__check--on),
  .topic:has(:checked) :global(.topic__check--off) {
    display: none;
  }

  .topic:has(:checked) :global(.topic__check--on) {
    display: inline-block;
  }

  /* ----- Project type chips ----- */

  .ptypes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ptype {
    cursor: pointer;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ptype:hover {
    border-color: var(--accent);
  }

  .ptype:has(:checked) {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .ptype:has(:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ----- Conditional fields ----- */

  .form .when-freelance,
  .form .when-job {
    display: none;
  }

  .form:has([name='topic'][value='freelance']:checked) .when-freelance {
    display: flex;
  }

  .form:has([name='topic'][value='job']:checked) .when-job {
    display: grid;
  }

  /* ----- Inputs ----- */

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 14px;
  }

  .field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 500;
  }

  .input {
    width: 100%;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    font-weight: 400;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .input:focus {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  .input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .input--area {
    min-height: 150px;
    resize: vertical;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ----- Footer & states ----- */

  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .privacy {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .state :global(.spin) {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .error {
    font-size: 14px;
    color: var(--accent-2-ink);
  }

  .success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 24px 0;
    outline: none;
  }

  .success__icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .success__title {
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .success__body {
    max-width: 30em;
    color: var(--muted);
  }

  .success :global(.btn) {
    margin-top: 8px;
  }
</style>
