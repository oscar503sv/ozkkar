---
/**
 * Blog search, tag filter and post grid. Filtering runs on the client over
 * the rendered cards (title, excerpt and tags), mirrored in `?q=&tag=`.
 * Without JS every post is listed.
 */
import PostCard from './PostCard.astro';
import FilterChip from '../ui/FilterChip.astro';
import Icon from '../ui/Icon.astro';
import type { Lang } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
import { getAllTags, type PostListing } from '../../lib/blog';

interface Props {
  posts: PostListing[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
const tags = getAllTags(posts);
---

<div class="explorer" data-blog-explorer>
  <div class="explorer__controls">
    <label class="search">
      <span class="sr-only">{t.blog.searchLabel}</span>
      <Icon name="magnifying-glass" size={18} class="search__icon" />
      <input
        type="search"
        name="q"
        class="search__input"
        placeholder={t.blog.search}
        autocomplete="off"
        data-blog-search
      />
    </label>

    <div class="tags" role="group" aria-label={t.blog.tagsLabel}>
      <FilterChip size="sm" active data-tag="">
        {t.blog.allTags}
      </FilterChip>
      {tags.map((tag) => (
        <FilterChip size="sm" data-tag={tag}>
          #{tag}
        </FilterChip>
      ))}
    </div>
  </div>

  <div class="empty" data-blog-empty hidden>
    <Icon name="magnifying-glass" size={32} />
    <p>{t.blog.noResults}</p>
    <button type="button" class="empty__clear" data-blog-clear>
      {t.blog.clear}
    </button>
  </div>

  <div class="grid" aria-live="polite">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-blog-explorer]');

  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-blog-search]')!;
    const tagButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const posts = [...root.querySelectorAll<HTMLElement>('[data-post]')];
    const empty = root.querySelector<HTMLElement>('[data-blog-empty]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-blog-clear]')!;
    const validTags = new Set(tagButtons.map((b) => b.dataset.tag).filter(Boolean));

    const params = new URLSearchParams(location.search);
    let query = params.get('q') ?? '';
    let tag = validTags.has(params.get('tag') ?? '') ? params.get('tag')! : '';

    function render(): void {
      const q = query.trim().toLowerCase();
      let visible = 0;

      posts.forEach((post) => {
        const tags = post.dataset.tags?.split(' ') ?? [];
        const match = (!tag || tags.includes(tag)) && (!q || post.dataset.search?.includes(q));
        post.hidden = !match;
        if (match) visible++;
      });

      tagButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      empty.hidden = visible > 0;

      const url = new URL(location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (tag) url.searchParams.set('tag', tag);
      else url.searchParams.delete('tag');
      history.replaceState(null, '', url);
    }

    input.value = query;
    input.addEventListener('input', () => {
      query = input.value;
      render();
    });

    tagButtons.forEach((button) =>
      button.addEventListener('click', () => {
        const value = button.dataset.tag ?? '';
        tag = value && tag === value ? '' : value;
        render();
      }),
    );

    clear.addEventListener('click', () => {
      query = '';
      tag = '';
      input.value = '';
      render();
      input.focus();
    });

    if (query || tag) render();
  }
</script>

<style>
  .explorer {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .explorer__controls {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .search {
    position: relative;
    display: block;
    max-width: 520px;
  }

  .search :global(.search__icon) {
    position: absolute;
    left: 16px;
    top: 50%;
    translate: 0 -50%;
    color: var(--muted);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 13px 16px 13px 46px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 16px;
    outline: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .search__input:focus {
    border-color: var(--accent);
    box-shadow: var(--ring);
  }

  .search__input::placeholder {
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .tags {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 calc(-1 * clamp(20px, 5vw, 72px));
      padding: 2px clamp(20px, 5vw, 72px);
      scrollbar-width: none;
    }
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 48px 24px;
    border-radius: 22px;
    background: var(--surface-2);
    color: var(--muted);
    text-align: center;
  }

  .empty__clear {
    all: unset;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent-ink);
  }

  .empty__clear:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 36px 24px;
  }
</style>
