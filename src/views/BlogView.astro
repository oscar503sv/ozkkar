---
import BlogExplorer from '../components/blog/BlogExplorer.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import AppLayout from '../layouts/AppLayout.astro';
import { otherLang, type Lang } from '../i18n/config';
import { routePath } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';
import { getPostListings } from '../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPostListings(lang);
---

<AppLayout
  lang={lang}
  active="blog"
  alternateUrl={routePath('blog', otherLang(lang))}
  title={t.blog.title}
  description={t.blog.intro}
>
  <div class="page">
    <PageHeader title={t.blog.title} lead={t.blog.intro} />
    <BlogExplorer posts={posts} lang={lang} />
  </div>
</AppLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
</style>
