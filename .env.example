# Resend API key used by /api/contact (https://resend.com/api-keys)
RESEND_API_KEY=

# Optional overrides (defaults shown)
# CONTACT_TO_EMAIL=hello@ozkkar.dev
# CONTACT_FROM_EMAIL="ozkkar.dev <contact@ozkkar.dev>"

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for the per-IP rate limit (4 messages / 24 h).
# The Vercel ↔ Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
